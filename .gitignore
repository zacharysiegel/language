# Rust build output
target/

# IDE
.idea/

# macOS
.DS_Store

# Per-machine Claude Code settings
.claude/settings.local.json

# Output of `course_builder build` and `publish local`: the clip store, bundles, the local repository, and the
# embedded bundle the web app serves
/build/
/web/static/embedded/

# Per-developer environment and its secrets bootstrap
.env

# Speech model files and the ONNX Runtime library downloaded by `course_builder build`
/models/

# Generated by `xcodegen generate` and by the iOS build's pre-build scripts
/ios/Language.xcodeproj/
/ios/Language/Resources/embedded_bundle/
/ios/Language/Info.plist

# Written by wrangler, including on a dry run
/web/.wrangler/
