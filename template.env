# Per-developer environment. Copy to `.env` and fill in local values; `.env` is not committed.

# `course_builder publish local` writes here and the web server serves it at /repository. A relative path
# resolves against the workspace root.
PORTUGUESE_COURSE_LOCAL_REPOSITORY_ROOT=build/repository

# The repository the web server's /discovery document points clients at: /repository for the local one, or the
# R2 bucket's public URL.
PORTUGUESE_COURSE_REPOSITORY_BASE_URL=/repository

# Secrets bootstrap. Generate a master key with `secr key` and store it here base64-encoded; use the same key to
# add entries to `secrets.yaml` with `secr encrypt`.
MASTER_SECRET=
# A relative path resolves against the workspace root.
SECR_STORE_PATH=secrets.yaml

# Cloudflare R2 publish target, read only by `course_builder publish cloudflare-r2`.
R2_ACCOUNT_ID=
R2_ARTIFACT_BUCKET=
R2_ARTIFACT_PUBLIC_BASE_URL=
R2_PUBLISH_ACCESS_KEY_ID=
