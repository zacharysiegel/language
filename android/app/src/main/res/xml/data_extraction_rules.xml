<?xml version="1.0" encoding="utf-8"?>
<!-- The progress file is backed up and transferred; the artifact cache and the installed embedded bundle are reproducible. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
